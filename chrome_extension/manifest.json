{
  "manifest_version": 3,
  "name": "Proxy Monitor",
  "version": "1.0.0",
  "description": "Inspect, mock and replay HTTP traffic via Proxy Monitor",
  "permissions": ["activeTab", "contextMenus", "clipboardWrite", "storage"],
  "host_permissions": ["http://localhost:8081/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches":["<all_urls>"],"js":["content.js"],"run_at":"document_start"}],
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}